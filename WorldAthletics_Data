def load_or_create_config():
    """Lädt die API-Credentials aus config.json oder erstellt die Datei mit Standardwerten."""
    config_path = Path(CONFIG_FILE)
    
    # Zuerst: Umgebungsvariablen prüfen
    api_key = os.getenv('WA_API_KEY')
    api_url = os.getenv('WA_API_URL')
    
    if api_key and api_url:
        return api_key, api_url
    
    # Zweiten: config.json prüfen
    if config_path.exists():
        try:
            with open(config_path, 'r', encoding='utf-8') as f:
                config = json.load(f)
                return config.get('api_key', DEFAULT_API_KEY), config.get('api_url', DEFAULT_API_URL)
        except Exception as e:
            print(f"⚠ Fehler beim Lesen von config.json: {e}")
    
    # Drittens: Standard-Werte mit Angebot zum Speichern
    config = {
        'api_key': DEFAULT_API_KEY,
        'api_url': DEFAULT_API_URL,
        'last_updated': datetime.now().isoformat(),
        'note': 'Ändern Sie diese Werte und speichern Sie erneut, um die API-Credentials zu aktualisieren.'
    }
    
    try:
        with open(config_path, 'w', encoding='utf-8') as f:
            json.dump(config, f, indent=2, ensure_ascii=False)
        print(f"✓ Konfigurationsdatei '{CONFIG_FILE}' erstellt")
    except Exception as e:
        print(f"⚠ Konnte config.json nicht erstellen: {e}")
    
    return DEFAULT_API_KEY, DEFAULT_API_URL


